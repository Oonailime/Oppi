generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StudyStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum AttemptMode {
  FULL
  DISCIPLINE
}

model Exam {
  id                      String     @id
  name                    String
  organization            String
  year                    Int
  role                    String?
  answerOptions           String[]   @default(["A", "B", "C", "D", "E"])
  defaultDurationMinutes  Int
  extendedDurationMinutes Int
  createdAt               DateTime   @default(now())
  questions               Question[]
  attempts                Attempt[]

  @@index([year])
}

model StudyTopic {
  id                Int                 @id
  module            String
  discipline        String
  syllabusItem      String
  subject           String
  detail            String?
  page              String
  suggestedPriority String
  questions         Question[]
  contestProgress   ContestStudyTopic[]

  @@index([discipline])
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  displayName  String
  passwordHash String
  createdAt    DateTime      @default(now())
  contests     Contest[]
  sessions     AuthSession[]
}

model AuthSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Contest {
  id            String              @id @default(uuid())
  userId        String
  name          String
  targetDate    DateTime?           @db.Date
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts      Attempt[]
  studySessions StudySession[]
  studyTopics   ContestStudyTopic[]

  @@index([userId])
  @@index([targetDate])
}

model ContestStudyTopic {
  contestId          String
  studyTopicId       Int
  status             StudyStatus @default(NOT_STARTED)
  progress           Int         @default(0)
  questionsCompleted Int         @default(0)
  correctAnswers     Int         @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  notes              String?
  contest            Contest     @relation(fields: [contestId], references: [id], onDelete: Cascade)
  studyTopic         StudyTopic  @relation(fields: [studyTopicId], references: [id], onDelete: Cascade)

  @@id([contestId, studyTopicId])
  @@index([contestId, status])
  @@index([studyTopicId])
}

model Question {
  id               Int             @id @default(autoincrement())
  examId           String
  number           Int
  discipline       String
  subject          String
  weight           Decimal         @db.Decimal(3, 1)
  sourcePage       Int
  sourceImage      String
  contextImage     String?
  correctAnswer    String?
  annulled         Boolean         @default(false)
  studyTopicId     Int?
  exam             Exam            @relation(fields: [examId], references: [id])
  studyTopic       StudyTopic?     @relation(fields: [studyTopicId], references: [id])
  attemptAnswers   AttemptAnswer[]

  @@unique([examId, number])
  @@index([examId, discipline])
  @@index([discipline])
  @@index([studyTopicId])
}

model Attempt {
  id                  String          @id @default(uuid())
  contestId           String
  examId              String
  mode                AttemptMode
  discipline          String?
  startedAt           DateTime        @default(now())
  completedAt         DateTime?
  durationSeconds     Int?
  timeLimitSeconds    Int
  targetSecondsPerQuestion Int
  totalQuestions      Int
  answeredQuestions   Int             @default(0)
  correctAnswers      Int             @default(0)
  annulledQuestions   Int             @default(0)
  rawPercentage       Decimal?        @db.Decimal(5, 2)
  weightedScore       Decimal?        @db.Decimal(6, 2)
  maxWeightedScore    Decimal?        @db.Decimal(6, 2)
  weightedPercentage  Decimal?        @db.Decimal(5, 2)
  contest             Contest         @relation(fields: [contestId], references: [id], onDelete: Cascade)
  exam                Exam            @relation(fields: [examId], references: [id])
  answers             AttemptAnswer[]

  @@index([contestId])
  @@index([contestId, completedAt])
  @@index([examId])
  @@index([completedAt])
  @@index([discipline])
}

model AttemptAnswer {
  id             String   @id @default(uuid())
  attemptId      String
  questionId     Int
  selectedAnswer String?
  isCorrect      Boolean
  awardedPoints  Decimal  @db.Decimal(3, 1)
  timeSpentSeconds Int    @default(0)
  attempt        Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model StudySession {
  id        String   @id @default(uuid())
  contestId String
  startedAt DateTime @default(now())
  endedAt   DateTime?
  contest   Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@index([contestId])
  @@index([contestId, endedAt])
  @@index([startedAt])
  @@index([endedAt])
}
