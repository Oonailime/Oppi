generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StudyStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum AttemptMode {
  FULL
  DISCIPLINE
  ALL_YEARS
}

enum ContestType {
  STANDARD
  RECURRING
}

enum ForeignLanguage {
  ENGLISH
  SPANISH
}

enum ContestDocumentKind {
  PREVIOUS_EXAM
  ANSWER_KEY
  NOTICE
}

model Exam {
  id                      String        @id
  name                    String
  organization            String
  year                    Int
  role                    String?
  answerOptions           String[]      @default(["A", "B", "C", "D", "E"])
  defaultDurationMinutes  Int
  extendedDurationMinutes Int
  systemManaged           Boolean       @default(true)
  createdAt               DateTime      @default(now())
  questions               Question[]
  attempts                Attempt[]
  contestAssignments      ContestExam[]

  @@index([year])
}

model StudyTopic {
  id                Int                 @id
  module            String
  discipline        String
  syllabusItem      String
  subject           String
  detail            String?
  page              String
  suggestedPriority String
  topicCode         String?
  topicTitle        String?
  isGroup           Boolean             @default(false)
  competencyCodes   String[]            @default([])
  skillCodes        String[]            @default([])
  sortOrder         Int                 @default(0)
  questions         Question[]
  contestProgress   ContestStudyTopic[]
  trainingAttempts  Attempt[]

  @@index([discipline])
  @@index([topicCode])
  @@index([isGroup])
}

model User {
  id                 String        @id @default(uuid())
  username           String        @unique
  displayName        String
  passwordHash       String?
  email              String?       @unique
  googleSubject      String?       @unique
  avatarUrl          String?
  birthDate          DateTime?     @db.Date
  cpf                String?       @unique
  profileCompletedAt DateTime?
  createdAt          DateTime      @default(now())
  contests           Contest[]
  sessions           AuthSession[]
}

model AuthSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Contest {
  id               String              @id @default(uuid())
  userId           String
  name             String
  targetDate       DateTime?           @db.Date
  type             ContestType         @default(STANDARD)
  systemManaged    Boolean             @default(false)
  desiredArea      String?
  description      String?             @db.Text
  storageDirectory String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts         Attempt[]
  documents        ContestDocument[]
  exams            ContestExam[]
  studySessions    StudySession[]
  studyTopics      ContestStudyTopic[]

  @@index([userId])
  @@index([targetDate])
}

model ContestDocument {
  id           String              @id @default(uuid())
  contestId    String
  kind         ContestDocumentKind
  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  sha256       String
  uploadedAt   DateTime            @default(now())
  contest      Contest             @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([contestId, kind])
  @@index([contestId])
}

model ContestExam {
  contestId String
  examId    String
  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@id([contestId, examId])
  @@index([examId])
}

model ContestStudyTopic {
  contestId          String
  studyTopicId       Int
  status             StudyStatus @default(NOT_STARTED)
  progress           Int         @default(0)
  questionsCompleted Int         @default(0)
  correctAnswers     Int         @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  notes              String?
  contest            Contest     @relation(fields: [contestId], references: [id], onDelete: Cascade)
  studyTopic         StudyTopic  @relation(fields: [studyTopicId], references: [id], onDelete: Cascade)

  @@id([contestId, studyTopicId])
  @@index([contestId, status])
  @@index([studyTopicId])
}

model Question {
  id               Int               @id @default(autoincrement())
  examId           String
  number           Int
  examDay          Int?
  variant          String            @default("")
  discipline       String
  subject          String
  weight           Decimal           @db.Decimal(3, 1)
  sourcePage       Int
  sourceImage      String
  contextImage     String?
  correctAnswer    String?
  annulled         Boolean           @default(false)
  studyTopicId     Int?
  exam             Exam              @relation(fields: [examId], references: [id])
  studyTopic       StudyTopic?       @relation(fields: [studyTopicId], references: [id])
  attemptAnswers   AttemptAnswer[]
  attemptQuestions AttemptQuestion[]

  @@unique([examId, number, variant])
  @@index([examId, discipline])
  @@index([examId, examDay])
  @@index([discipline])
  @@index([studyTopicId])
}

model Attempt {
  id                       String            @id @default(uuid())
  contestId                String
  examId                   String?
  trainingTopicId          Int?
  examDay                  Int?
  mode                     AttemptMode
  discipline               String?
  foreignLanguage          ForeignLanguage?
  includeCorrectAnswers    Boolean           @default(false)
  startedAt                DateTime          @default(now())
  completedAt              DateTime?
  draftAnswers             Json?
  draftQuestionTimes       Json?
  draftCurrentIndex        Int               @default(0)
  draftElapsedSeconds      Int               @default(0)
  draftSavedAt             DateTime?
  durationSeconds          Int?
  timeLimitSeconds         Int
  targetSecondsPerQuestion Int
  totalQuestions           Int
  answeredQuestions        Int               @default(0)
  correctAnswers           Int               @default(0)
  annulledQuestions        Int               @default(0)
  rawPercentage            Decimal?          @db.Decimal(5, 2)
  weightedScore            Decimal?          @db.Decimal(6, 2)
  maxWeightedScore         Decimal?          @db.Decimal(6, 2)
  weightedPercentage       Decimal?          @db.Decimal(5, 2)
  contest                  Contest           @relation(fields: [contestId], references: [id], onDelete: Cascade)
  exam                     Exam?             @relation(fields: [examId], references: [id])
  trainingTopic            StudyTopic?       @relation(fields: [trainingTopicId], references: [id])
  answers                  AttemptAnswer[]
  questions                AttemptQuestion[]

  @@index([contestId])
  @@index([contestId, completedAt])
  @@index([examId])
  @@index([trainingTopicId])
  @@index([completedAt])
  @@index([discipline])
}

model AttemptQuestion {
  attemptId  String
  questionId Int
  position   Int
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id])

  @@id([attemptId, questionId])
  @@unique([attemptId, position])
  @@index([questionId])
}

model AttemptAnswer {
  id               String   @id @default(uuid())
  attemptId        String
  questionId       Int
  selectedAnswer   String?
  isCorrect        Boolean
  awardedPoints    Decimal  @db.Decimal(3, 1)
  timeSpentSeconds Int      @default(0)
  attempt          Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model StudySession {
  id        String    @id @default(uuid())
  contestId String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  contest   Contest   @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@index([contestId])
  @@index([contestId, endedAt])
  @@index([startedAt])
  @@index([endedAt])
}
